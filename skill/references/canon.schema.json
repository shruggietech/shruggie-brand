{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand.shruggie.tech/schema/canon.schema.json",
  "title": "ShruggieTech brand definition",
  "type": "object",
  "required": ["id", "kind", "version"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "kind": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "showcase_surface": {"type": "string", "minLength": 1},
    "affiliation": {"$ref": "#/$defs/affiliation"},
    "semantic_colors": {
      "type": "object",
      "required": ["emphasis", "action"],
      "additionalProperties": false,
      "properties": {
        "emphasis": {"$ref": "#/$defs/hexColor"},
        "action": {"$ref": "#/$defs/hexColor"}
      }
    },
    "typography": {"$ref": "#/$defs/typography"},
    "authoritative_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/authoritativeInput"},
      "default": []
    },
    "palette_approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/paletteApproval"},
      "default": []
    },
    "approval_ledger": {"$ref": "#/$defs/approvalLedger"},
    "identity_continuity": {"$ref": "#/$defs/identityContinuityReference"},
    "vendor_boundary": {"$ref": "#/$defs/vendorBoundary"},
    "accent": {
      "type": "object",
      "required": ["bright", "deep", "accessible"],
      "properties": {
        "bright": {"$ref": "#/$defs/hexColor"},
        "deep": {"$ref": "#/$defs/hexColor"},
        "accessible": {"$ref": "#/$defs/hexColor"}
      },
      "additionalProperties": true
    },
    "logo": {
      "type": "object",
      "required": ["source_mode"],
      "properties": {
        "source_mode": {"enum": ["constructed", "authoritative"]},
        "authoritative_input_ids": {"$ref": "#/$defs/authoritativeLogoBindings"},
        "application_icon": {"$ref": "#/$defs/applicationIcon"},
        "square_enclosure": {"$ref": "#/$defs/squareEnclosure"}
      },
      "additionalProperties": true,
      "allOf": [
        {"if": {"properties": {"source_mode": {"const": "authoritative"}}}, "then": {"required": ["authoritative_input_ids"]}},
        {"if": {"properties": {"source_mode": {"const": "constructed"}}}, "then": {"not": {"required": ["authoritative_input_ids"]}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"not": {"const": "canon"}}}, "required": ["kind"]},
      "then": {"required": ["title", "slug", "affiliation", "typography", "accent", "logo", "identity_continuity"]}
    },
    {
      "if": {"properties": {"kind": {"const": "parent-brand"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "affiliation": {
            "properties": {
              "ownership": {"const": "shruggietech-owned"},
              "parent": {"type": "null"},
              "inheritance": {"const": "shruggietech-house"},
              "endorsement": {"const": "none"},
              "service_credit": {"const": "none"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"affiliation": {"properties": {"inheritance": {"const": "independent"}}, "required": ["inheritance"]}}, "required": ["affiliation"]},
      "then": {"required": ["semantic_colors"]}
    },
    {
      "if": {"properties": {"identity_continuity": {"properties": {"status": {"const": "approved-canonical"}}, "required": ["status"]}}, "required": ["identity_continuity"]},
      "then": {
        "required": ["approval_ledger"],
        "properties": {
          "approval_ledger": {
            "properties": {"gate_1": {"required": ["canonical_source_sha256"]}}
          }
        }
      }
    }
  ],
  "$defs": {
    "hexColor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "applicationIcon": {
      "type": "object",
      "required": ["background"],
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "#/$defs/hexColor"}
      }
    },
    "squareEnclosure": {
      "type": "object",
      "required": ["canvas_size", "inset", "corner_radius", "stroke_width", "content_scale", "frame_role", "stroke_role", "knockout_role", "monochrome_knockout"],
      "additionalProperties": false,
      "properties": {
        "canvas_size": {"type": "number", "exclusiveMinimum": 0},
        "inset": {"type": "number", "minimum": 0},
        "corner_radius": {"type": "number", "minimum": 0},
        "stroke_width": {"type": "number", "minimum": 0},
        "content_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "frame_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "stroke_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "knockout_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "monochrome_knockout": {"const": true}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identityContinuityReference": {
      "type": "object",
      "required": ["record", "status"],
      "additionalProperties": false,
      "properties": {
        "record": {"enum": ["identity-continuity.json"]},
        "status": {"enum": ["approved-canonical", "historical-baseline"]}
      }
    },
    "identityContinuityRecord": {
      "type": "object",
      "required": ["schema_version", "brand", "status", "source_class", "recorded_on", "source_revision", "source_files", "identity_snapshot", "topology", "framing", "palette", "renderer", "proofs", "approval", "historical_evidence", "record_sha256"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "brand": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["approved-canonical", "historical-baseline"]},
        "source_class": {"enum": ["authoritative", "glyphkit-constructed", "legacy-constructed"]},
        "recorded_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "source_revision": {"type": "string", "minLength": 1},
        "source_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identitySourceFile"}},
        "identity_snapshot": {"$ref": "#/$defs/identitySnapshot"},
        "topology": {"type": "object"},
        "framing": {"type": "object"},
        "palette": {"type": "object"},
        "renderer": {"anyOf": [{"$ref": "#/$defs/identityRenderer"}, {"type": "null"}]},
        "proofs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identityProof"}},
        "approval": {"anyOf": [{"$ref": "#/$defs/canonicalIdentityApproval"}, {"type": "null"}]},
        "historical_evidence": {"anyOf": [{"$ref": "#/$defs/historicalIdentityEvidence"}, {"type": "null"}]},
        "palette_qualification": {"anyOf": [{"$ref": "#/$defs/identityPaletteQualification"}, {"type": "null"}]},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "historical-baseline"}}, "required": ["status"]},
          "then": {
            "properties": {
              "renderer": {"type": "null"},
              "proofs": {"maxItems": 0},
              "approval": {"type": "null"},
              "historical_evidence": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "approved-canonical"}}, "required": ["status"]},
          "then": {
            "required": ["palette_qualification"],
            "properties": {
              "renderer": {"$ref": "#/$defs/identityRenderer"},
              "proofs": {"minItems": 32, "maxItems": 32},
              "approval": {"$ref": "#/$defs/canonicalIdentityApproval"},
              "historical_evidence": {"type": "null"},
              "palette_qualification": {"$ref": "#/$defs/identityPaletteQualification"}
            }
          }
        }
      ]
    },
    "identitySourceFile": {
      "type": "object",
      "required": ["path", "purpose", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "purpose": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identitySnapshot": {
      "type": "object",
      "required": ["source_class", "geometry", "derivative_settings", "topology", "framing", "palette", "typography", "sha256"],
      "additionalProperties": false,
      "properties": {
        "source_class": {"enum": ["authoritative", "glyphkit-constructed", "legacy-constructed"]},
        "geometry": {"type": "object"},
        "derivative_settings": {"type": "object"},
        "topology": {"type": "object"},
        "framing": {"type": "object"},
        "palette": {"type": "object"},
        "typography": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identityRenderer": {
      "type": "object",
      "required": ["id", "version", "settings_sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "settings_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identityProof": {
      "type": "object",
      "required": ["variant", "size_px", "surface", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "variant": {"enum": ["full", "reduced"]},
        "size_px": {"enum": [16, 32, 64, 256]},
        "surface": {"enum": ["dark", "light", "black", "white"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalIdentityApproval": {
      "type": "object",
      "required": ["bundle_id", "approved_by", "approved_on", "owner_wording", "scope", "proposal_sha256", "source_snapshot_sha256"],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "owner_wording": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["full-master", "reduced-master", "palette", "framing", "topology", "renderer", "proof-matrix"]}},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "historicalIdentityEvidence": {
      "type": "object",
      "required": ["basis", "baseline_revision", "approval_completeness", "limitation", "migration_issue"],
      "additionalProperties": false,
      "properties": {
        "basis": {"const": "current-authoritative-source"},
        "baseline_revision": {"type": "string", "minLength": 1},
        "approval_completeness": {"enum": ["complete", "partial", "unknown"]},
        "limitation": {"type": "string", "minLength": 1},
        "migration_issue": {"const": 185}
      }
    },
    "identityPaletteQualification": {
      "type": "object",
      "required": ["status", "srgb_roles", "oklch_roles", "checks", "evidence_sha256"],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "passed"},
        "srgb_roles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hexColor"}},
        "oklch_roles": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
        "checks": {
          "type": "object",
          "required": ["contrast", "sibling_separation", "color_vision", "semantic_roles", "surfaces", "single_ink", "rendered_color"],
          "additionalProperties": false,
          "properties": {
            "contrast": {"const": true}, "sibling_separation": {"const": true},
            "color_vision": {"const": true}, "semantic_roles": {"const": true},
            "surfaces": {"const": true}, "single_ink": {"const": true},
            "rendered_color": {"const": true}
          }
        },
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "vendorBoundary": {
      "type": "object",
      "required": ["required", "notice", "entities", "trademark_owner", "terms_responsibility"],
      "additionalProperties": false,
      "properties": {
        "required": {"const": true},
        "notice": {"type": "string", "minLength": 1},
        "entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "trademark_owner": {"type": "string", "minLength": 1},
        "terms_responsibility": {"type": "string", "minLength": 1}
      }
    },
    "approvalLedger": {
      "type": "object",
      "required": ["source_hashes", "gate_1", "gate_2"],
      "additionalProperties": false,
      "properties": {
        "source_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "gate_1": {
          "type": "object",
          "required": ["status", "approved_by", "approved_on", "scope", "derivative_config_sha256"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "approved"},
            "approved_by": {"type": "string", "minLength": 1},
            "approved_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["reduced-and-platform", "horizontal-lockup", "stacked-lockup", "wordmark-only", "single-ink"]}},
            "derivative_config_sha256": {"$ref": "#/$defs/sha256"},
            "canonical_source_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "gate_2": {
          "type": "object",
          "required": ["status", "approved_by", "approved_on", "derivative_manifest_sha256", "surfaces"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "approved", "rejected"]},
            "approved_by": {"type": ["string", "null"]},
            "approved_on": {"type": ["string", "null"]},
            "derivative_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "surfaces": {"type": "array", "uniqueItems": true, "items": {"enum": ["showcase-card", "brand-landing-page", "guideline-topics", "downloads", "registry-endpoints", "public-metadata", "structured-data", "social-preview"]}}
          }
        }
      }
    },
    "affiliation": {
      "type": "object",
      "required": ["ownership", "showcase", "parent", "inheritance", "endorsement", "service_credit"],
      "additionalProperties": false,
      "properties": {
        "ownership": {"enum": ["shruggietech-owned", "third-party"]},
        "showcase": {"enum": ["public", "private"]},
        "parent": {"type": ["string", "null"]},
        "inheritance": {"enum": ["shruggietech-house", "independent"]},
        "endorsement": {"enum": ["shruggietech-project", "none"]},
        "service_credit": {"enum": ["brand-system-by-shruggietech", "none"]}
      },
      "oneOf": [
        {
          "properties": {
            "ownership": {"const": "shruggietech-owned"},
            "parent": {"const": "ShruggieTech"},
            "inheritance": {"const": "shruggietech-house"},
            "endorsement": {"const": "shruggietech-project"},
            "service_credit": {"const": "none"}
          }
        },
        {
          "properties": {
            "ownership": {"const": "shruggietech-owned"},
            "parent": {"type": "null"},
            "inheritance": {"const": "shruggietech-house"},
            "endorsement": {"const": "none"},
            "service_credit": {"const": "none"}
          }
        },
        {
          "properties": {
            "ownership": {"const": "third-party"},
            "parent": {"type": "null"},
            "endorsement": {"const": "none"},
            "service_credit": {"enum": ["brand-system-by-shruggietech", "none"]}
          }
        }
      ]
    },
    "family": {
      "type": "object",
      "required": ["name", "weights"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "weights": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 1000}}
      }
    },
    "fontFace": {
      "type": "object",
      "required": ["role", "path", "weight", "style", "format", "sha256", "license", "provenance", "usage_status"],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["display", "body", "mono"]},
        "path": {"type": "string", "pattern": "^fonts/"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 1000},
        "style": {"enum": ["normal", "italic", "oblique"]},
        "format": {"enum": ["ttf", "otf", "woff2"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "usage_status": {"const": "approved"}
      }
    },
    "typography": {
      "type": "object",
      "required": ["mode", "families"],
      "properties": {
        "mode": {"enum": ["house", "fixed"]},
        "families": {
          "type": "object",
          "required": ["display", "body", "mono"],
          "additionalProperties": false,
          "properties": {
            "display": {"$ref": "#/$defs/family"},
            "body": {"$ref": "#/$defs/family"},
            "mono": {"$ref": "#/$defs/family"}
          }
        },
        "faces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fontFace"}}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"mode": {"const": "fixed"}}}, "then": {"required": ["faces"]}},
        {"if": {"properties": {"mode": {"const": "house"}}}, "then": {"not": {"required": ["faces"]}}}
      ]
    },
    "authoritativeInput": {
      "type": "object",
      "required": ["id", "role", "path", "format", "sha256", "color_profile", "usage_status", "license", "approved_transformations"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "role": {"enum": ["mark", "reduced-mark", "wordmark", "reference-art"]},
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["svg", "png", "jpeg", "webp"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "color_profile": {"enum": ["srgb", "embedded", "none", "unknown"]},
        "usage_status": {"enum": ["approved", "reference-only"]},
        "license": {"type": "string", "minLength": 1},
        "approved_mask": {"enum": ["alpha", "luminance"]},
        "mask_source_sha256": {"$ref": "#/$defs/sha256"},
        "mask_approved_by": {"type": "string", "minLength": 1},
        "mask_approved_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "approved_transformations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["embed-unchanged", "recolor-mask", "resize", "place-in-lockup", "palette-analysis"]}
        }
      }
    },
    "authoritativeLogoBindings": {
      "type": "object",
      "required": ["full", "reduced"],
      "additionalProperties": false,
      "properties": {
        "full": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "reduced": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "paletteApproval": {
      "type": "object",
      "required": ["input_id", "source_sha256", "selected_candidate", "canonical_tokens", "approved_by", "approved_on"],
      "additionalProperties": false,
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "selected_candidate": {"$ref": "#/$defs/hexColor"},
        "canonical_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"}},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_on": {"type": "string", "format": "date"}
      }
    }
  },
  "additionalProperties": true
}
