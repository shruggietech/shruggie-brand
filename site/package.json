{
  "name": "shruggie-brand-site",
  "version": "2.4.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prepare:content": "python ../scripts/prepare_site.py && fumadocs-mdx",
    "build": "pnpm prepare:content && next build",
    "dev": "pnpm prepare:content && next dev",
    "lint": "pnpm prepare:content && tsc --noEmit",
    "test": "node --test tests/production-origin.test.mjs tests/payload-contract.test.mjs && node scripts/verify-site.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.15.11",
    "fumadocs-ui": "16.15.11",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zbsearch": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-mdx": "15.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
