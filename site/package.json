{
  "name": "shruggie-brand-site",
  "version": "3.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    }
  },
  "scripts": {
    "prepare:content": "python ../scripts/prepare_site.py && fumadocs-mdx",
    "build": "pnpm prepare:content && next build",
    "dev": "pnpm prepare:content && next dev",
    "lint": "pnpm prepare:content && tsc --noEmit",
    "test": "node --test tests/production-origin.test.mjs tests/payload-contract.test.mjs && node scripts/verify-site.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.0",
    "fumadocs-ui": "16.17.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zbsearch": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "fumadocs-mdx": "15.4.7",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
