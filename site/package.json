{
  "name": "shruggie-brand-site",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prepare:content": "python ../scripts/prepare_site.py && fumadocs-mdx",
    "build": "pnpm prepare:content && next build",
    "dev": "pnpm prepare:content && next dev",
    "lint": "pnpm prepare:content && tsc --noEmit",
    "test": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.14.3",
    "fumadocs-ui": "16.14.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zbsearch": "3.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fumadocs-mdx": "15.2.3",
    "tailwindcss": "4.2.4",
    "typescript": "^5.9.0"
  }
}
